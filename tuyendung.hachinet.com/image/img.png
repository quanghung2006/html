<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="referrer" content="origin-when-cross-origin">
    <script>//<![CDATA[
      var s = false;
      function l() {
        setTimeout(f, 10000);
        if (document.referrer) {
          try {
            var pm = /(^|&|\?)px=([^&]*)(&|$)/i;
            var px = window.location.href.match(pm);
            var rs = document.referrer;
            if (px != null) {
              if (rs.match(pm))
                rs = rs.replace(pm, "$1px=" + px[2] + "$3");
              else if (rs.indexOf("?") != -1)
                rs = rs + "&px=" + px[2];
              else
                rs = rs + "?px=" + px[2];
            }
            history.replaceState({}, "Bing", rs);
            window.addEventListener("pageshow", function(e) { if (e.persisted || (typeof window.performance != "undefined" && window.performance.navigation.type === 2)) window.location.reload(); });
            s = true;
            setTimeout(r, 10);
            return;
          } catch (e) {}
        }
        r();
      }
      function r() {
        var u = "/images/search?q=%E1%BA%A3nh%20logo%20cong%20ngh%E1%BA%B9%20d%C3%B4ng%20%C3%A1&FORM=IQFRBA&id=8FD2BE2FB6132A5BB017BFC307220D5575A8EB77";
        if (s)
          window.location.href = u;
        else
          window.location.replace(u);
      }
      function f() {
        document.getElementById("fb").style.display = "block";
      }
      //]]>
    </script>
  </head>
  <body onload="l()">
    <div id="fb" style="display: none">
      Please <a href="https://www.bing.com/ck/a?!&&p=7f5cc6e11f922ca03cc21a7ff5ddd855ad4e3f7fd281984158355c28d0b8a100JmltdHM9MTczOTgzNjgwMA&ptn=3&ver=2&hsh=4&fclid=1640ba68-1fcd-69c7-20d0-ae9d1e426833&u=a1L2ltYWdlcy9zZWFyY2g_cT0lRTElQkElQTNuaCUyMGxvZ28lMjBjb25nJTIwbmdoJUUxJUJBJUI5JTIwZCVDMyVCNG5nJTIwJUMzJUExJkZPUk09SVFGUkJBJmlkPThGRDJCRTJGQjYxMzJBNUJCMDE3QkZDMzA3MjIwRDU1NzVBOEVCNzc&ntb=F">click here</a> if the page does not redirect automatically ...
    </div>
  </body>
</html>